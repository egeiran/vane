{
  "expo": {
    "name": "Vane",
    "slug": "vane",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vane",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "no.egeiran.vane",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "nb",
        "CFBundleLocalizations": [
          "nb"
        ]
      }
    },
    "android": {
      "package": "no.egeiran.vane"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F6F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#111112"
          }
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.no.egeiran.vane",
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "I dag",
              "description": "Huk av dagens vaner rett fra hjemskjermen.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "src/widgets/TodayWidget.tsx"
              }
            },
            {
              "name": "LockWidget",
              "displayName": "Vane",
              "description": "Dagens vaner og mål på låseskjermen.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "src/widgets/LockWidget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "no.egeiran.vane.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.no.egeiran.vane"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "2c5905dd-5719-47d1-a8be-0822949bb2e6"
      }
    }
  }
}
